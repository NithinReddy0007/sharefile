# Frontend Environment Variables
# Copy this file to frontend/.env for local development

# Firebase Function URL
# Local emulator:  http://127.0.0.1:5001/<project-id>/us-central1/api
# Production:      https://<region>-<project-id>.cloudfunctions.net/api
VITE_API_BASE_URL=http://127.0.0.1:5001/your-project-id/us-central1/api
